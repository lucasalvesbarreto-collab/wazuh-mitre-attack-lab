<!--
  T1110 - Brute Force (Credential Access)
    T1110.001 Password Guessing  -> 100110
    T1110.003 Password Spraying  -> 100111
    Correlação com T1078 (Valid Accounts) -> 100112 e 100113

  Uso: copiar o bloco <group> abaixo para /var/ossec/etc/rules/local_rules.xml e validar antes
  de reiniciar o manager:
    sudo /var/ossec/bin/wazuh-analysisd -t

  Regra padrão pai: 60122 (Logon Failure - Unknown user or bad password, evento 4625).
  Regras 100112/100113: pais 60106 (Windows Logon Success) e 92657 (logon de rede bem-sucedido).
-->

<group name="windows,authentication_failures,attack_lab,">

  <!-- T1110.001: várias falhas para o MESMO usuário -->
  <rule id="100110" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>T1110.001: 5+ falhas de logon para o mesmo usuário em 2 min</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- T1110.003: falhas para VÁRIOS usuários a partir da mesma origem -->
  <rule id="100111" level="12" frequency="6" timeframe="180">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <different_field>win.eventdata.targetUserName</different_field>
    <description>T1110.003: possível password spraying (6+ usuários distintos, mesma origem)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <!-- T1110 + T1078: logon com SUCESSO na conta que sofreu brute force -->
  <rule id="100112" level="14" timeframe="600">
    <if_sid>60106,92657</if_sid>
    <if_matched_sid>100110</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>T1110/T1078: logon com sucesso após brute force na mesma conta (provável comprometimento)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- Variante para spraying: sucesso a partir da mesma origem após o alerta de spray -->
  <rule id="100113" level="14" timeframe="600">
    <if_sid>60106,92657</if_sid>
    <if_matched_sid>100111</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>T1110.003/T1078: logon com sucesso da mesma origem após password spraying</description>
    <mitre>
      <id>T1110.003</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- T1136.002: conta de domínio criada (evento 4720, visão do sistema operacional) -->
  <rule id="100120" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>T1136.002: conta de domínio criada - $(win.eventdata.targetUserName) por $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136.002</id>
    </mitre>
  </rule>

  <!-- T1136.002: net user /add executado (Sysmon evento 1, visão do processo) -->
  <rule id="100121" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bnet1?(\.exe)?\s+user\s+.*\/add</field>
    <description>T1136.002: 'net user /add' executado por $(win.eventdata.user)</description>
    <mitre>
      <id>T1136.002</id>
    </mitre>
  </rule>

</group>
